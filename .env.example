# 复制为 .env 后填写；.env 已被 .gitignore 排除，不要提交
# LLM_PROVIDER：deepseek（真实模型）| mock（离线确定性回放，无需 key）
# LLM_API_KEY 留空会自动降级为 mock，服务仍可完整运行
# 注意：值后面可以写行内注释（解析器会剥离「空白 + #」之后的内容）
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
PORT=3200
HOST=127.0.0.1
DB_PATH=data/agent.db
TZ_OFFSET=+08:00

# Agent 预算（可选，留空用默认值）
# AGENT_MAX_STEPS=8
# AGENT_MAX_TOOL_CALLS=12
# AGENT_TURN_BUDGET_MS=180000
# AGENT_TOOL_TIMEOUT_MS=20000
